# Adapted from coreos/ignition v2.27.0 dracut/30ignition/ignition-disks.service.
# Partitions (sgdisk), sets up RAID/LUKS and creates filesystems.
[Unit]
Description=Ignition (disks)
Documentation=https://coreos.github.io/ignition/
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/run/ignition/user.ign
DefaultDependencies=no
Before=ignition-complete.target

# Stage order: credentials -> fetch-offline [-> fetch] -> disks -> mount -> files.
After=ignition-fetch-offline.service ignition-fetch.service
Before=ignition-mount.service

# The root is tmpfs (root=tmpfs), so upstream's Before=sysroot.mount and
# Before=initrd-root-device.target do not apply. Finish partitioning and
# formatting before any /sysroot file system is declared mounted; persistent
# state disks are mounted by the real root (e.g. var.mount), long after this.
Before=initrd-fs.target

OnFailure=emergency.target
OnFailureJobMode=isolate

# This stage requires udevd to detect disk partitioning changes.
Requires=systemd-udevd.service
After=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=disks
