# Adapted from coreos/ignition v2.27.0 dracut/30ignition/ignition-fetch.service.
[Unit]
Description=Ignition (fetch)
Documentation=https://coreos.github.io/ignition/
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/run/ignition/user.ign
DefaultDependencies=no
Before=ignition-complete.target
After=basic.target
# Only when fetch-offline asked for the network and did not cache a config.
ConditionPathExists=/run/ignition/neednet
ConditionPathExists=!/run/ignition.json

# Stage order: credentials -> fetch-offline [-> fetch] -> disks -> mount -> files.
After=ignition-fetch-offline.service
Before=ignition-disks.service

OnFailure=emergency.target
OnFailureJobMode=isolate

# Upstream leaves bringing up the network to the distro and orders after
# network.target. The initrd already runs systemd-networkd, and
# systemd-networkd-wait-online is linked into network-online.target by
# oci/bluefin-server-boot.bst, so wait for a routable link here.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=fetch
