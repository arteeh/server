# Adapted from coreos/ignition v2.27.0 dracut/30ignition/ignition-mount.service.
# Mounts filesystems that set storage.filesystems[].path under /sysroot so the
# files stage can write into them; ExecStop unmounts them before switch-root.
# Mounts that must persist after switch-root need their own mount unit.
[Unit]
Description=Ignition (mount)
Documentation=https://coreos.github.io/ignition/
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/run/ignition/user.ign
DefaultDependencies=no
Before=ignition-complete.target

# Stage order: credentials -> fetch-offline [-> fetch] -> disks -> mount -> files.
After=ignition-disks.service
Before=ignition-files.service

# Make sure ExecStop= runs before we switch root, while the network (ordered
# after, so stopped before it) is still up.
Before=initrd-switch-root.target
After=network.target

OnFailure=emergency.target
OnFailureJobMode=isolate

# /sysroot (tmpfs) must be mounted since we mount under it. Finish before
# initrd-fs.target so bluefin-populate-etc.service and ignition-files.service
# see the Ignition mounts.
Requires=initrd-root-fs.target
After=initrd-root-fs.target
Before=initrd-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=mount
ExecStop=/usr/bin/ignition --root=/sysroot --platform=metal --stage=umount
