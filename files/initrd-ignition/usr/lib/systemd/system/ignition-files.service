# Adapted from coreos/ignition v2.27.0 dracut/30ignition/ignition-files.service.
# Writes users/groups (useradd/usermod --root=/sysroot), SSH keys, files,
# links and systemd units into /sysroot/etc and enables units through
# /sysroot/etc/systemd/system-preset/20-ignition.preset, which the real
# root's PID 1 applies on its first boot (every boot: /etc is populated fresh).
[Unit]
Description=Ignition (files)
Documentation=https://coreos.github.io/ignition/
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/run/ignition/user.ign
DefaultDependencies=no
Before=ignition-complete.target

OnFailure=emergency.target
OnFailureJobMode=isolate

# Stage order: credentials -> fetch-offline [-> fetch] -> disks -> mount -> files.
After=ignition-mount.service

# /sysroot/etc starts empty and is filled by bluefin-populate-etc.service with
# systemd-tmpfiles `C` lines, which skip any path that already exists. Run
# after it so Ignition edits the factory /etc (passwd, shadow, systemd/...)
# instead of pre-creating directories that would suppress their factory
# copies. useradd/usermod and the chrooted user lookups also need the real
# root's /usr (nsswitch, libnss) at /sysroot/usr.
#
# Upstream orders Before=initrd-parse-etc.service; that is a cycle here
# (initrd-fs.target is After=initrd-parse-etc.service), so fstab entries an
# Ignition config writes are mounted by the real root, not the initrd.
After=bluefin-populate-etc.service initrd-fs.target
RequiresMountsFor=/sysroot/usr
Before=initrd.target initrd-cleanup.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=files
