# Adapted from coreos/ignition v2.27.0 dracut/30ignition/ignition-fetch-offline.service.
# Writes /run/ignition.json if the config (plus everything it references) is
# available offline; otherwise creates /run/ignition/neednet so
# ignition-fetch.service runs once the network is online.
[Unit]
Description=Ignition (fetch-offline)
Documentation=https://coreos.github.io/ignition/
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/run/ignition/user.ign
DefaultDependencies=no
Before=ignition-complete.target
After=basic.target

# Stage order: credentials -> fetch-offline [-> fetch] -> disks -> mount -> files.
Requires=bluefin-ignition-credentials.service
After=bluefin-ignition-credentials.service
Before=ignition-fetch.service

OnFailure=emergency.target
OnFailureJobMode=isolate

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ignition --root=/sysroot --platform=metal --stage=fetch-offline
