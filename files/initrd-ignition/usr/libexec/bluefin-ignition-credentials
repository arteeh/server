#!/usr/bin/bash
# bluefin-ignition-credentials — stage an Ignition config from system credentials.
#
# Bluefin Server's kernel command line is sealed into the signed UKI, so
# Ignition's ignition.config.url= karg cannot be used. Its config is taken
# from system credentials instead (SMBIOS type 11, QEMU fw_cfg, or
# /loader/credentials on the ESP), imported into $CREDENTIALS_DIRECTORY by
# ImportCredential= in bluefin-ignition-credentials.service:
#
#   ignition.config      an Ignition JSON (or, since Ignition 2.27, Butane
#                        YAML) config; copied verbatim
#   ignition.config.url  a URL (http, https, tftp, s3, gs, arn, data);
#                        wrapped in a config whose ignition.config.replace
#                        points at it, so ignition-fetch pulls the real config
#                        once the network is online
#
# If both are set, ignition.config wins and ignition.config.url is ignored.
#
# Without either credential, a network-booted node looks for bluefin-node.ign
# in the directory it booted from, as reported by /usr/libexec/bluefin-boot-origin:
# the UEFI HTTP boot URL (StubDeviceURL EFI variable), the same way the initrd
# derives the /usr image URL, or, for a node chainloaded by iPXE, the explicit
# http(s) URL its boot server (Booty) passes in rd.systemd.pull. If the boot
# server has one (HTTP HEAD succeeds), it is used through config.replace;
# otherwise Ignition is skipped.
#
# Output: /run/ignition/user.ign (absent when there is nothing to apply), the highest-priority user config path that
# Ignition's "system" provider reads before the platform provider
# (internal/distro/distro.go SystemRuntimeConfigDir,
# internal/providers/system/system.go, Ignition >= 2.27.0).
#
# Deliberately bash builtins, coreutils and curl only.

set -euo pipefail
export LC_ALL=C

PROG="${0##*/}"
OUT=/run/ignition/user.ign
# Newest stable config spec in Ignition v2.27.0 (config/v3_6). A replaced
# config may use any spec version Ignition accepts.
STUB_VERSION=3.6.0
# A scheme, then no whitespace, control characters, '"' or '\': the value is
# pasted into a JSON string unescaped, so refuse anything that would need it.
URL_RE='^[A-Za-z][A-Za-z0-9+.-]*:[^[:space:][:cntrl:]"\]+$'

log() { printf '%s: %s\n' "${PROG}" "$*" >&2; }
die() { log "$*"; exit 1; }

NODE_CONFIG=bluefin-node.ign
BOOT_ORIGIN="${BLUEFIN_BOOT_ORIGIN:-/usr/libexec/bluefin-boot-origin}"

creds="${CREDENTIALS_DIRECTORY:-/nonexistent}"
config="${creds}/ignition.config"
url_cred="${creds}/ignition.config.url"

stage_url() {
  [[ "$1" =~ ${URL_RE} ]] || die "invalid Ignition config URL: $(printf '%q' "$1")"
  printf '{"ignition":{"version":"%s","config":{"replace":{"source":"%s"}}}}\n' \
    "${STUB_VERSION}" "$1" > "${OUT}.tmp"
}

umask 077
mkdir -p "${OUT%/*}"

if [ -s "${config}" ]; then
  [ ! -s "${url_cred}" ] || log "ignition.config and ignition.config.url both set; ignoring ignition.config.url"
  cp "${config}" "${OUT}.tmp"
  log "staged inline config from credential ignition.config"
elif [ -s "${url_cred}" ]; then
  url="$(<"${url_cred}")"
  stage_url "${url}"
  log "staged config.replace of ${url} (credential ignition.config.url)"
elif boot_url="$("${BOOT_ORIGIN}")"; then
  url="${boot_url%/*}/${NODE_CONFIG}"
  if curl -sfI --retry 3 --connect-timeout 10 -o /dev/null "${url}"; then
    stage_url "${url}"
    log "staged config.replace of ${url} (next to the HTTP boot origin)"
  else
    log "no ${NODE_CONFIG} next to ${boot_url}; nothing to apply"
    exit 0
  fi
else
  log "no Ignition credential and no network boot origin; nothing to apply"
  exit 0
fi

mv -f "${OUT}.tmp" "${OUT}"
