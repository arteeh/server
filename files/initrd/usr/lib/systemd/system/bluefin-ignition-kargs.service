[Unit]
Description=Check for ignored Ignition kernel arguments
Documentation=file:/usr/libexec/bluefin-boot-diagnostics
ConditionPathExists=/etc/initrd-release
DefaultDependencies=no
# Linked into initrd.target.wants by oci/bluefin-server-boot.bst. Warn before
# Ignition would have run, so the warning sits next to where it is missing.
Before=bluefin-ignition-credentials.service initrd.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bluefin-boot-diagnostics ignition-kargs
