[Unit]
Description=Check that the OS image fits in RAM before downloading it
Documentation=file:/usr/libexec/bluefin-boot-diagnostics
ConditionPathExists=/etc/initrd-release
DefaultDependencies=no
# Wanted by, and ordered before, systemd-import@%i.service through its drop-in
# systemd-import@.service.d/10-bluefin-pull-check.conf. Needs the network,
# like the download itself.
Wants=network-online.target
After=network-online.target

# The check fails only when the server gives a size that cannot fit in RAM:
# print why on the console and reboot (emergency.service.d/10-reboot.conf)
# rather than start that download. When it cannot check the size, it notes
# that on the console and succeeds, and the download runs.
OnFailure=emergency.target
OnFailureJobMode=isolate

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bluefin-boot-diagnostics check-pull systemd-import@%i.service
