# Homelab: the sysext's 20-wired.network drop-in turns on mDNS, but
# systemd-networkd may have read its configuration before systemd-sysext
# merged the image. Reload it once merged, before anything resolves or
# announces a .local name. Wanted by multi-user.target from this sysext.
[Unit]
Description=Apply the homelab mDNS network configuration
Documentation=https://github.com/projectbluefin/server/blob/main/files/homelab/cluster/README.md
ConditionPathExists=/etc/bluefin/homelab.conf
After=systemd-sysext.service systemd-networkd.service systemd-resolved.service
Before=network-online.target kubeadm-init.service k0scontroller.service
Before=bluefin-cluster-prepare.service bluefin-cluster-serve.service bluefin-cluster-join.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/networkctl reload
