{
  "ignition": {
    "version": "3.6.0"
  },
  "passwd": {
    "users": [
      {
        "name": "root",
        "sshAuthorizedKeys": [
          "# REPLACE with your SSH public key, e.g. ssh-ed25519 AAAA... you@example.com"
        ]
      }
    ]
  },
  "storage": {
    "files": [
      {
        "overwrite": true,
        "path": "/etc/sysupdate.d/homelab.feature.d/50-homelab.conf",
        "contents": {
          "compression": "",
          "source": "data:,%5BFeature%5D%0AEnabled%3Dtrue%0A"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/sysconfig/k0s",
        "contents": {
          "compression": "",
          "source": "data:,K0S_CONTROLLER_ARGS%3D--enable-worker%20--no-taints%20--disable-components%3Dhelm%2Cautopilot%0A"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/tmpfiles.d/50-bluefin-homelab.conf",
        "contents": {
          "compression": "",
          "source": "data:,C%20%2Fetc%2Fbluefin%2Fhomelab.conf%20-%20-%20-%20-%20%2Fetc%2Fbluefin%2Fhomelab.conf.template%0A"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/bluefin/homelab.conf.template",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 384
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "enabled": true,
        "name": "sshd.service"
      },
      {
        "enabled": true,
        "name": "bluefin-sysext-fetch.service"
      },
      {
        "enabled": true,
        "name": "k0s-first-boot.service"
      }
    ]
  }
}
