# namespace name key=value... ; @file:<path> reads an operator file (the
# component is skipped while it is missing), @random generates a value once.
# The GitHub OAuth app (callback http://kubestellar.<HOMELAB_DOMAIN>/auth/github/callback):
# its client id and secret, each written without a trailing newline (printf %s).
kubestellar-console kubestellar-console-github-oauth github-client-id=@file:/etc/bluefin/homelab.d/kubestellar-console/github-client-id github-client-secret=@file:/etc/bluefin/homelab.d/kubestellar-console/github-client-secret
kubestellar-console kubestellar-console-jwt jwt-secret=@random
