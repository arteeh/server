# Upstream kubernetes/release kubelet.service; kubeadm's 10-kubeadm.conf
# drop-in supplies the real ExecStart. Until `kubeadm join` writes
# /var/lib/kubelet/config.yaml kubelet exits and is restarted every 10s,
# which is the standard kubeadm behaviour.
[Unit]
Description=kubelet: The Kubernetes Node Agent
Documentation=https://kubernetes.io/docs/
Wants=network-online.target
After=network-online.target containerd.service

[Service]
ExecStart=/usr/bin/kubelet
Restart=always
StartLimitInterval=0
RestartSec=10

[Install]
WantedBy=multi-user.target
