# iscsid is socket-activated by the first iscsiadm call; iscsid.service pulls
# in iscsi-init.service (Requires=), which writes initiatorname.iscsi only
# when absent. Node auto-login (iscsi.service) and the Broadcom offload
# daemon stay off. FSDK has no catch-all "disable *".
enable iscsid.socket
disable iscsid.service
disable iscsi-init.service
disable iscsi.service
disable iscsiuio.service
disable iscsiuio.socket
