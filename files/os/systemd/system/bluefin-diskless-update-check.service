[Unit]
Description=Check the Boot Server for a Newer Bluefin Server Release
Documentation=file:/usr/libexec/bluefin-diskless-update-check
# Diskless boots only: the OS DDI pulled at boot is attached from here. This is
# the inverse of systemd-sysupdate.service.d/10-diskless.conf; installed nodes
# update with systemd-sysupdate and the USB installer has no rootdisk.raw.
ConditionPathExists=/run/machines/rootdisk.raw
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The pull source of a node booted with the import.pull credential (netboot
# ESP with /loader/credentials, dogfood VM), read by bluefin-boot-origin.
ImportCredential=import.pull
ExecStart=/usr/libexec/bluefin-diskless-update-check
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
