[Unit]
Description=Deadline for a Boot-Counted Boot to Reach boot-complete.target
Documentation=file:/usr/libexec/bluefin-boot-deadline man:systemd-bless-boot.service(8)
# Boot-counted boots only: systemd-boot sets LoaderBootCountPath when the entry
# it booted carries a tries counter, i.e. a UKI systemd-sysupdate installed and
# systemd-bless-boot has not marked good yet. Never on diskless or USB
# installer boots.
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
ConditionPathExists=!/run/machines/rootdisk.raw
ConditionKernelCommandLine=!root=tmpfs

[Timer]
# Change it with a drop-in; clear the list first, e.g.
#   [Timer]
#   OnBootSec=
#   OnBootSec=30min
OnBootSec=15min
AccuracySec=10s

[Install]
WantedBy=timers.target
