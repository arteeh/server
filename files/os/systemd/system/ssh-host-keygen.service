[Unit]
Description=Generate SSH host keys on first sshd start
Documentation=man:ssh-keygen(1)
# Host keys are deliberately NOT baked into the DDI: the release artifact is
# public, so build-time keys would hand every deployment's host identity to
# anyone who downloads the image. Generate them per device instead.
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=sshd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
