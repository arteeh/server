[Unit]
Description=Initialise the Kubernetes control plane with kubeadm
Documentation=https://kubernetes.io/docs/reference/setup-tools/kubeadm/kubeadm-init/
# The idempotency guard belongs here and nowhere else. A unit whose condition
# fails is marked *skipped*, and systemd treats a skipped unit as satisfied for
# everything ordered after it, so bluefin-cluster-bootstrap.service still runs.
ConditionPathExists=!/etc/kubernetes/admin.conf
# /usr/bin/kubeadm arrives with the sysext merge (elements/oci/kubernetes-sysext.bst
# stages kubectl, kubeadm, kubelet and the CNI plugins — and nothing else).
Requires=systemd-sysext.service
After=systemd-sysext.service
# containerd.service is NOT supplied by that sysext and is not built anywhere in
# this repository. It reaches the image only through Flatcar's /usr
# (usr/share/flatcar/sysext/containerd-flatcar.raw), which arrives with
# elements/flatcar/flatcar-usr.bst in PR #140 and is consumed by os-stack.bst in
# PR #132. Until both land this is an unresolvable job: the control plane does
# not start, and bluefin-cluster-bootstrap.service does not run either, because
# it declares Requires=kubeadm-init.service.
#
# The requirement is correct and stays hard on purpose — kubeadm against a host
# with no CRI socket fails late and confusingly, where an unresolvable job fails
# immediately and names the missing unit. tests/unit/test_unit_dependency_provenance.py
# records the gap so it cannot be forgotten.
Requires=containerd.service
After=containerd.service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/kubelet

[Service]
Type=oneshot
# RemainAfterExit is what makes the ordering edge useful: the unit stays active
# after kubeadm exits, so dependents see a control plane that is still up.
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=900
# Cilium provides the kube-proxy replacement; installing kube-proxy as well
# would leave two datapaths fighting over the same Services.
ExecStart=/usr/bin/kubeadm init --config /usr/share/bluefin/kubeadm.yaml --skip-phases=addon/kube-proxy

[Install]
WantedBy=multi-user.target
