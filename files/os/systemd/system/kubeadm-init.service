[Unit]
Description=Initialise the Kubernetes control plane with kubeadm
Documentation=https://kubernetes.io/docs/reference/setup-tools/kubeadm/kubeadm-init/
# The idempotency guard belongs here and nowhere else. A unit whose condition
# fails is marked *skipped*, and systemd treats a skipped unit as satisfied for
# everything ordered after it, so bluefin-cluster-bootstrap.service still runs.
ConditionPathExists=!/etc/kubernetes/admin.conf
# Both /usr/bin/kubeadm and containerd.service arrive with the sysext merge, but
# from two different extensions, each seeded to /var/lib/extensions by
# files/installer/repart.d/30-var.conf:
#
#   kubernetes.raw  elements/oci/kubernetes-sysext.bst — kubeadm, kubelet,
#                   kubectl, CNI plugins.
#   containerd-flatcar.raw  elements/flatcar/containerd-sysext.bst — Flatcar's containerd
#                   sysext: containerd, runc, ctr, containerd-shim-runc-v2, and
#                   containerd.service itself. FSDK 26.08 ships no containerd
#                   component, so this import is the only provider.
#
# containerd-flatcar.raw carries its own multi-user.target.wants symlink, so the merge
# enables the service; no preset of ours is involved.
Requires=systemd-sysext.service
After=systemd-sysext.service
# Hard on purpose: kubeadm against a host with no CRI socket fails late and
# confusingly, where an unresolvable job fails immediately and names the missing
# unit. tests/unit/test_unit_dependency_provenance.py records the provider.
Requires=containerd.service
After=containerd.service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/kubelet

[Service]
Type=oneshot
# RemainAfterExit is what makes the ordering edge useful: the unit stays active
# after kubeadm exits, so dependents see a control plane that is still up.
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=900
# Cilium provides the kube-proxy replacement; installing kube-proxy as well
# would leave two datapaths fighting over the same Services.
ExecStart=/usr/bin/kubeadm init --config /usr/share/bluefin/kubeadm.yaml --skip-phases=addon/kube-proxy

[Install]
WantedBy=multi-user.target
