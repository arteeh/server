#!/usr/bin/bash
# bluefin-update-pending — is there a staged update worth rebooting into?
#
# Exit 0 when `systemd-sysupdate pending` reports a newer installed version
# than the booted one AND that version has not already failed its boot tries.
# Exit 1 otherwise.
#
# A version that failed its tries keeps its UKI as
# bluefin-server-<ver>+0-<done>.efi: systemd-boot sorts it last and boots the
# previous one, so a reboot lands on the booted version again. systemd-sysupdate
# does not look at the counter and still reports it as pending, so without this
# check a node that rolled back would flag kured after every update run, or
# reboot in every nightly window, and never leave the version it is on. The
# next newer release takes the failed version's slot and UKI (InstancesMax=2)
# and clears the block.
#
# Used by systemd-sysupdate.service.d/20-kured.conf (the kured flag) and
# systemd-sysupdate-reboot.service.d/20-interlock.conf (the local reboot).
#
# Test overrides: BLUEFIN_SYSUPDATE, BLUEFIN_BOOT_PATH, BLUEFIN_OS_RELEASE.

set -euo pipefail
export LC_ALL=C

sysupdate="${BLUEFIN_SYSUPDATE:-/usr/bin/systemd-sysupdate}"
os_release="${BLUEFIN_OS_RELEASE:-/usr/lib/os-release}"
boot="${BLUEFIN_BOOT_PATH:-$(bootctl --print-boot-path 2>/dev/null || echo /boot)}"

"${sysupdate}" pending || exit 1

booted=""
if [ -r "${os_release}" ]; then
  while IFS='=' read -r key value; do
    [ "${key}" = IMAGE_VERSION ] || continue
    value="${value%\"}"; value="${value#\"}"
    booted="${value}"
  done < "${os_release}"
fi
[ -n "${booted}" ] || exit 0

for uki in "${boot}"/EFI/Linux/bluefin-server-*+0-*.efi "${boot}"/EFI/Linux/bluefin-server-*+0.efi; do
  [ -e "${uki}" ] || continue
  name="${uki##*/bluefin-server-}"
  version="${name%%+*}"
  if systemd-analyze compare-versions "${version}" gt "${booted}" >/dev/null; then
    echo "Bluefin Server ${version} is installed but failed its boot tries (${uki##*/}); staying on ${booted} until a newer release replaces it"
    exit 1
  fi
done
exit 0
