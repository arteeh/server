#!/usr/bin/bash
# bluefin-diskless-update-check — flag a diskless node whose boot server
# offers a newer Bluefin Server release.
#
# A diskless node runs the OS DDI it pulled into RAM at boot, and it updates
# by rebooting into whatever its boot server serves at that point. This check
# tells the node when a reboot would bring a newer image:
#
#   1. find the directory the node booted from (bluefin-boot-origin);
#   2. fetch SHA256SUMS and SHA256SUMS.gpg from it and verify the signature
#      with gpgv against the image keyring. This is the same trust root as the
#      initrd's `rd.systemd.pull ... verify=signature`;
#   3. read the release version from the manifest's bluefin-server_<ver>.raw
#      entry and compare it with the running IMAGE_VERSION using
#      `systemd-analyze compare-versions`, the ordering systemd-sysupdate uses;
#   4. if the release is newer and the next boot would pick it up, touch
#      /run/reboot-required (the sentinel kured watches) and log the new
#      version.
#
# Whether the next boot picks it up depends on what the origin names. A
# netboot UKI served under a fixed name (Booty's bluefin-server-netboot.efi,
# found through StubDeviceURL) resolves the image at boot: the server swaps the
# UKI and the next boot pulls the newer image next to it. An origin that names
# a versioned file, bluefin-server_<ver>.raw (an explicit rd.systemd.pull= URL
# or the import.pull credential) or bluefin-server-netboot_<ver>.efi, is
# pinned: the node pulls the same version again after a reboot. Flagging it
# would make kured drain and reboot the node on every check, so a pinned node
# only logs that a newer release is available.
#
# It never reboots. Network and signature errors are logged and leave the
# flag untouched, and the check always exits 0, so a boot server that cannot
# be reached never fails a unit.
#
# Journal priorities come from SyslogLevelPrefix: <4> warning, <5> notice,
# <6> info.
#
# Test overrides: BLUEFIN_BOOT_ORIGIN (the origin helper),
# BLUEFIN_IMPORT_KEYRING, BLUEFIN_REBOOT_SENTINEL, BLUEFIN_OS_RELEASE, and
# BLUEFIN_CMDLINE / BLUEFIN_STUB_URL_VAR, which bluefin-boot-origin reads.

set -euo pipefail
export LC_ALL=C

boot_origin="${BLUEFIN_BOOT_ORIGIN:-/usr/libexec/bluefin-boot-origin}"
sentinel="${BLUEFIN_REBOOT_SENTINEL:-/run/reboot-required}"
os_release="${BLUEFIN_OS_RELEASE:-/usr/lib/os-release}"
# systemd reads /etc/systemd/import-pubring.pgp before the vendor keyring.
keyring="${BLUEFIN_IMPORT_KEYRING:-}"
if [ -z "${keyring}" ]; then
  keyring=/usr/lib/systemd/import-pubring.pgp
  [ -e /etc/systemd/import-pubring.pgp ] && keyring=/etc/systemd/import-pubring.pgp
fi

info() { printf '<6>%s\n' "$*"; }
notice() { printf '<5>%s\n' "$*"; }
warn() { printf '<4>%s\n' "$*"; }

running=""
if [ -r "${os_release}" ]; then
  while IFS='=' read -r key value; do
    [ "${key}" = IMAGE_VERSION ] || continue
    value="${value%\"}"; value="${value#\"}"
    running="${value}"
  done < "${os_release}"
fi
if [ -z "${running}" ]; then
  warn "no IMAGE_VERSION in ${os_release}; not checking for updates"
  exit 0
fi

if ! origin="$("${boot_origin}")"; then
  info "not network booted (no boot origin); nothing to check"
  exit 0
fi
base="${origin%/*}"
file="${origin##*/}"
pinned=""
[[ "${file}" =~ ^bluefin-server(-netboot)?_[0-9A-Za-z.]+\.(raw|efi)$ ]] && pinned="${file}"

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

fetch() {
  curl -fsS --proto '=http,https' --retry 2 --connect-timeout 10 --max-time 60 \
    --max-filesize 1048576 -o "${tmp}/$1" "${base}/$1"
}
if ! fetch SHA256SUMS || ! fetch SHA256SUMS.gpg; then
  warn "cannot fetch SHA256SUMS and SHA256SUMS.gpg from ${base}/; not flagging an update"
  exit 0
fi

mkdir -m 0700 "${tmp}/gnupg"
if ! GNUPGHOME="${tmp}/gnupg" gpgv --keyring "${keyring}" \
    "${tmp}/SHA256SUMS.gpg" "${tmp}/SHA256SUMS"; then
  warn "SHA256SUMS from ${base}/ does not verify against ${keyring}; not flagging an update"
  exit 0
fi

offered=""
while read -r _ name; do
  name="${name#\*}"
  [[ "${name}" =~ ^bluefin-server_([0-9A-Za-z.]+)\.raw$ ]] || continue
  version="${BASH_REMATCH[1]}"
  if [ -z "${offered}" ] ||
      systemd-analyze compare-versions "${version}" gt "${offered}" >/dev/null; then
    offered="${version}"
  fi
done < "${tmp}/SHA256SUMS"
if [ -z "${offered}" ]; then
  warn "SHA256SUMS from ${base}/ lists no bluefin-server_<version>.raw; not flagging an update"
  exit 0
fi

if ! systemd-analyze compare-versions "${offered}" gt "${running}" >/dev/null; then
  info "up to date: ${base}/ offers ${offered}, running ${running}"
elif [ -n "${pinned}" ]; then
  notice "Bluefin Server ${offered} is available from ${base}/ (running ${running}), but this node is pinned to ${pinned}; not flagging ${sentinel}, point its boot origin at the new release to update"
else
  mkdir -p "${sentinel%/*}"
  touch "${sentinel}"
  notice "Bluefin Server ${offered} is available from ${base}/ (running ${running}); flagged ${sentinel}, reboot to update"
fi
