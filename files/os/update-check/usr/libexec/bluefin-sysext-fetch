#!/usr/bin/bash
# bluefin-sysext-fetch — fetch the sysexts of the sysupdate features this node
# enabled, for the booted image version, and merge them.
#
# A provisioning config (the homelab Ignition templates in
# files/homelab/templates/) enables optional sysupdate features with
# /etc/sysupdate.d/<feature>.feature.d/*.conf (Enabled=true) and links
# bluefin-sysext-fetch.service. The version-locked sysexts then follow OS
# updates through systemd-sysupdate, but nothing fetches them for the version
# that is already running: this does, once per image version. The image file
# each enabled feature's transfer installs (e.g.
# /var/lib/extensions/kubeadm_<ver>.raw) comes from the first source that
# has it:
#
#   1. seed: <ESP>/bluefin/extensions/, which the USB installer's Homelab
#      entries copy onto the installed disk (offline install); removed from
#      the ESP once used;
#   2. diskless node: the directory it booted from (bluefin-boot-origin),
#      which serves the whole release set;
#   3. installed node: the release, through plain `systemd-sysupdate update`.
#      With the features enabled it repairs the booted version, which now
#      lacks their files; if the release is newer it installs that version
#      instead, and the node reboots into it.
#
# 1 and 2 run systemd-sysupdate against copies of the feature transfers in
# /run whose Source Path= is that directory and whose Features= line is
# dropped. Each file must match its sha256 in the source's SHA256SUMS. The
# boot server's and the release's SHA256SUMS must be signed by the image's
# import keyring (Verify=yes, as for every update). The seed's is not
# (Verify=no): it was copied from the installer onto this disk, so it is as
# trustworthy as the disk it is read from and where the sysexts land.
#
# Afterwards `systemd-sysext refresh` merges what arrived and
# bluefin-sysext-activate.service starts the units the merged sysexts (and
# the provisioning config's links) enable.
#
# Test overrides: BLUEFIN_SYSUPDATE_DIRS (feature drop-in and transfer search
# path, highest priority first), BLUEFIN_OS_RELEASE, BLUEFIN_ESP,
# BLUEFIN_ROOTDISK, BLUEFIN_BOOT_ORIGIN, BLUEFIN_UPDATE_PENDING,
# BLUEFIN_SYSEXT_FETCH_RUN; commands (systemd-sysupdate, systemd-sysext,
# systemctl, bootctl) through PATH.

set -euo pipefail
export LC_ALL=C

PROG="${0##*/}"
read -r -a dirs <<<"${BLUEFIN_SYSUPDATE_DIRS:-/etc/sysupdate.d /run/sysupdate.d /usr/local/lib/sysupdate.d /usr/lib/sysupdate.d}"
os_release="${BLUEFIN_OS_RELEASE:-/usr/lib/os-release}"
rootdisk="${BLUEFIN_ROOTDISK:-/run/machines/rootdisk.raw}"
boot_origin="${BLUEFIN_BOOT_ORIGIN:-/usr/libexec/bluefin-boot-origin}"
update_pending="${BLUEFIN_UPDATE_PENDING:-/usr/libexec/bluefin-update-pending}"
run="${BLUEFIN_SYSEXT_FETCH_RUN:-${RUNTIME_DIRECTORY:-/run/bluefin-sysext-fetch}}"

log() { printf '%s: %s\n' "${PROG}" "$*"; }
die() { log "$*" >&2; exit 1; }

version=""
while IFS='=' read -r key value; do
  [ "${key}" = IMAGE_VERSION ] || continue
  value="${value%\"}"; value="${value#\"}"
  version="${value}"
done < "${os_release}"
[ -n "${version}" ] || die "no IMAGE_VERSION in ${os_release}"

# The features an Enabled= drop-in turns on; drop-ins in higher-priority
# directories, and later ones in a directory, win.
declare -A state=()
for ((n = ${#dirs[@]} - 1; n >= 0; n--)); do
  for conf in "${dirs[n]}"/*.feature.d/*.conf; do
    [ -e "${conf}" ] || continue
    name="${conf%/*}"; name="${name##*/}"; name="${name%.feature.d}"
    v="$(sed -n 's/^[[:space:]]*Enabled[[:space:]]*=[[:space:]]*//p' "${conf}" | tail -n 1)"
    [ -z "${v}" ] || state[${name}]="${v,,}"
  done
done
enabled=()
for name in "${!state[@]}"; do
  case "${state[${name}]}" in 1|yes|y|true|t|on) enabled+=("${name}") ;; esac
done
[ "${#enabled[@]}" -gt 0 ] || { log "no optional sysupdate feature is enabled; nothing to fetch"; exit 0; }
mapfile -t enabled < <(printf '%s\n' "${enabled[@]}" | sort)

# <section> <key> <file>: the last value of key in [section].
ini() {
  sed -n "/^\[$1\]/,/^\[/{s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p}" "$3" | tail -n 1
}

# Transfers of the enabled features, each with the file it installs for this
# version and the file it downloads for it.
transfers=() targets=() sources=()
declare -A done_transfer=()
for d in "${dirs[@]}"; do
  for t in "${d}"/*.transfer; do
    [ -e "${t}" ] || continue
    name="${t##*/}"
    [ -z "${done_transfer[${name}]:-}" ] || continue
    done_transfer[${name}]=1
    read -r -a features <<<"$(ini Transfer Features "${t}")"
    want=0
    for f in "${features[@]}"; do
      for e in "${enabled[@]}"; do [ "${f}" != "${e}" ] || want=1; done
    done
    [ "${want}" = 1 ] || continue
    path="$(ini Target Path "${t}")"
    target="$(ini Target MatchPattern "${t}")"
    source="$(ini Source MatchPattern "${t}")"
    [ -n "${path}" ] && [ -n "${target}" ] && [ -n "${source}" ] \
      || die "${t}: needs [Target] Path=, MatchPattern= and [Source] MatchPattern="
    transfers+=("${t}")
    targets+=("${path%/}/${target//@v/${version}}")
    sources+=("${source//@v/${version}}")
  done
done
[ "${#transfers[@]}" -gt 0 ] || { log "enabled features ${enabled[*]} have no transfers; nothing to fetch"; exit 0; }

missing() {
  local i
  for i in "${!transfers[@]}"; do
    [ -e "${targets[i]}" ] || printf '%s\n' "${i}"
  done
}

# <dir> <url> <verify> <index...>: systemd-sysupdate with copies of those
# transfers that download from <url> regardless of their features.
fetch_from() {
  local defs="${run}/$1" url="$2" verify="$3" i
  shift 3
  rm -rf "${defs}"
  mkdir -p "${defs}"
  for i in "$@"; do
    sed -e '/^[[:space:]]*Features[[:space:]]*=/d' \
        -e '/^[[:space:]]*Verify[[:space:]]*=/d' \
        -e "s|^\[Transfer\]|[Transfer]\nVerify=${verify}|" \
        -e "/^\[Source\]/,/^\[/s|^[[:space:]]*Path[[:space:]]*=.*|Path=${url}|" \
        "${transfers[i]}" > "${defs}/${transfers[i]##*/}"
  done
  systemd-sysupdate --definitions="${defs}" update
}

mapfile -t need < <(missing)
if [ "${#need[@]}" -eq 0 ]; then
  log "the ${enabled[*]} sysext(s) for ${version} are already installed"
  exit 0
fi
log "fetching for ${version}: $(for i in "${need[@]}"; do printf '%s ' "${targets[i]##*/}"; done)"
mode=""

# 1. The installer's seed on the ESP: only what its signed manifest lists.
esp="${BLUEFIN_ESP:-$(bootctl --print-esp-path 2>/dev/null || true)}"
seed="${esp:+${esp%/}/bluefin/extensions}"
if [ -n "${seed}" ] && [ -s "${seed}/SHA256SUMS" ]; then
  from_seed=()
  for i in "${need[@]}"; do
    grep -qE "^[0-9a-f]{64} [ *]${sources[i]//./\\.}\$" "${seed}/SHA256SUMS" && from_seed+=("${i}")
  done
  if [ "${#from_seed[@]}" -gt 0 ]; then
    log "installing from the installer's copy in ${seed}/"
    fetch_from seed "file://${seed}/" no "${from_seed[@]}"
    mode=seed
  fi
  # The ESP is small and holds the A/B UKIs; the copy is not needed again.
  rm -rf "${seed}"
  mapfile -t need < <(missing)
fi

if [ "${#need[@]}" -gt 0 ]; then
  if [ -e "${rootdisk}" ]; then
    # 2. A diskless node: the boot server's copy of this release.
    origin="$("${boot_origin}")" \
      || die "diskless, but no boot origin to fetch $(for i in "${need[@]}"; do printf '%s ' "${sources[i]}"; done)from"
    log "fetching from the boot server ${origin%/*}/"
    fetch_from origin "${origin%/*}/" yes "${need[@]}"
    mode=origin
  else
    # 3. An installed node: the release, as the update timer would.
    log "fetching through systemd-sysupdate (features: ${enabled[*]})"
    systemd-sysupdate update
    mode=release
  fi
  mapfile -t need < <(missing)
fi

if [ "${#need[@]}" -gt 0 ]; then
  if [ "${mode}" = release ] && "${update_pending}"; then
    log "the release is newer than ${version}; its sysexts arrived with it, rebooting into it"
    systemctl reboot
    exit 0
  fi
  die "still missing: $(for i in "${need[@]}"; do printf '%s ' "${targets[i]}"; done)"
fi

systemd-sysext refresh
systemctl daemon-reload
# Start what the merged sysexts enable (e.g. kubeadm-init.service linked by
# Ignition, bluefin-cluster-join.service): at boot this joins the start job
# that waits for this unit (Before=); after a retry it starts it again.
systemctl start --no-block bluefin-sysext-activate.service
log "merged the ${enabled[*]} sysext(s) for ${version} (${mode})"
