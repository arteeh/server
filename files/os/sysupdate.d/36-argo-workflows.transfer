[Transfer]
Features=argo-workflows
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/projectbluefin/server/releases/latest/download/
MatchPattern=argo-workflows_@v.raw.zst

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=argo-workflows_@v.raw
Mode=0444
InstancesMax=2
