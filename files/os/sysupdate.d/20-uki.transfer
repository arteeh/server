[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/projectbluefin/server/releases/latest/download/
MatchPattern=bluefin-server-@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=bluefin-server-@v+@l-@d.efi \
             bluefin-server-@v+@l.efi \
             bluefin-server-@v.efi
TriesLeft=3
TriesDone=0
InstancesMax=2
