#!/usr/bin/bash
# bluefin-boot-origin — print the URL a network-booted node was booted from.
#
# Sources, first match wins:
#   1. the UEFI HTTP boot URL that systemd-stub records in the StubDeviceURL
#      EFI variable (what the netboot UKI's `rd.systemd.pull=...bootorigin:`
#      resolves against);
#   2. the explicit http(s) source of `rd.systemd.pull=` on the kernel command
#      line (a node chainloaded by iPXE, e.g. from Booty);
#   3. the http(s) source of the `import.pull` system credential, when the
#      calling unit imports it (ImportCredential=import.pull): a netboot ESP
#      with /loader/credentials, or the dogfood VM's SMBIOS credential.
#
# The URL names the file that was booted or pulled; callers use its directory.
# Exits 1, printing nothing, when the node was not network booted.
#
# Shared by bluefin-ignition-credentials (initrd) and
# bluefin-diskless-update-check (booted OS). Bash builtins and coreutils only.
# BLUEFIN_STUB_URL_VAR and BLUEFIN_CMDLINE override the input paths for tests.

set -euo pipefail
export LC_ALL=C

stub_var="${BLUEFIN_STUB_URL_VAR:-/sys/firmware/efi/efivars/StubDeviceURL-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f}"
cmdline="${BLUEFIN_CMDLINE:-/proc/cmdline}"

# rd.systemd.pull= and import.pull share one syntax: <options>:<name>:<url>.
pull_url() {
  case "$1" in
    *:http://*|*:https://*)
      printf '%s\n' "http${1#*:http}"
      return 0 ;;
  esac
  return 1
}

if [ -r "${stub_var}" ]; then
  # efivarfs: 4 attribute bytes, then a NUL-terminated UTF-16LE string.
  url="$(tail -c +5 "${stub_var}" | tr -d '\000')"
  if [ -n "${url}" ]; then
    printf '%s\n' "${url}"
    exit 0
  fi
fi

if [ -r "${cmdline}" ]; then
  read -r -a args < "${cmdline}" || true
  for arg in "${args[@]}"; do
    case "${arg}" in
      rd.systemd.pull=*) pull_url "${arg#rd.systemd.pull=}" && exit 0 ;;
    esac
  done
fi

cred="${CREDENTIALS_DIRECTORY:-/nonexistent}/import.pull"
if [ -r "${cred}" ]; then
  read -r line < "${cred}" || true
  pull_url "${line:-}" && exit 0
fi

exit 1
