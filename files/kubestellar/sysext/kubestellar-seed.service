[Unit]
Description=Seed the KubeStellar, Argo CD and kiosk manifests for k0s
Documentation=https://docs.kubestellar.io
Before=k0scontroller.service
RequiresMountsFor=/var/lib/k0s

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/k0s-manifests.conf
# Per-node kiosk TLS identity: the sysext is a public release asset, so the
# key is generated on the node on first use and never shipped.
ExecStart=/usr/bin/sh -c 'test -s /var/lib/k0s/kiosk/key.pem || { umask 077; /usr/bin/openssl req -x509 -nodes -days 3650 -newkey rsa:2048 -keyout /var/lib/k0s/kiosk/key.pem -out /var/lib/k0s/kiosk/cert.pem -subj "/CN=KubeStellar Console" -addext "subjectAltName=DNS:localhost,DNS:*.local,IP:127.0.0.1"; chmod 0644 /var/lib/k0s/kiosk/cert.pem; }'
ExecStart=/usr/share/k0s/kubeflex/generate-postgres-secret.sh
ExecStart=/usr/share/k0s/kubeflex/generate-console-secret.sh
